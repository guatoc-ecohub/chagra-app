# Plantilla de configuración. Copie este archivo a .env.local y complete solo
# lo que necesite. Ninguna variable es obligatoria: vacías, la aplicación usa
# sus valores por omisión y funciona sin conexión con datos locales.

# Servidor farmOS propio (opcional, para sincronizar)
VITE_FARMOS_URL=
VITE_FARMOS_CLIENT_ID=
VITE_FARMOS_SCOPES=
VITE_AUTH_PKCE_ENABLED=

# Finca por omisión (opcional)
VITE_DEFAULT_FARM_NAME=
VITE_DEFAULT_LOCATION_ID=
VITE_FARM_LAT=
VITE_FARM_LON=
VITE_FARM_ALTITUD_MSNM=
VITE_FARM_MUNICIPIO=
VITE_FARM_THERMAL_ZONES=
VITE_PRIMARY_WORKER_NAME=
VITE_OPERATOR_USERNAME=
# Migración única de un nombre de trabajador heredado (déjela vacía)
VITE_LEGACY_WORKER_NAME=

# Modo demostración con datos de ejemplo
VITE_DEMO_MODE=
VITE_DEMO_SEED_PATH=

# Integraciones opcionales
VITE_ELEVATION_API_URL=
VITE_DEEP_RESEARCH_ENABLED=
VITE_LLM_CONTEXT_MAX_ASSETS=
VITE_MARKET_NODE_ID=
VITE_MARKET_PRODUCTS_PATH=
VITE_PRO_MODULES_PATH=
VITE_WEB_PUSH_PUBLIC_KEY=

# Hosts del despliegue que no deben redirigir al dominio canónico (opcional).
# Listas separadas por comas; vacías = sin excepción.
VITE_STAGING_HOSTS=
VITE_3D_WORLD_HOST=
VITE_CAMPESINO_PREVIEW_HOST=
# Endpoint farmOS de la finca pública de ejemplo (opcional; vacío = sin sync)
VITE_PUBLIC_FINCA_FARMOS_URL=

# Build: ruta a la fuente del valle 3D (opcional; vacía o inexistente = se omite)
VALLE_SRC_DIR=

# Desarrollo (npm run dev): URL de servicios locales para el proxy de Vite.
# Vacías = ese proxy no se monta. Ejemplo: DEV_OLLAMA_URL=http://localhost:<puerto>
DEV_OLLAMA_URL=
DEV_HA_URL=
